# Copy to .env and fill in only the providers you use.
# .env is git-ignored. Never commit real keys.

# Upstream provider keys (referenced from providers.yaml as ${VAR})
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Client key that apps must send as "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 32
OLLAROUTER_API_KEY=

# Open WebUI JWT secret (only for the bundled Open WebUI service).
# Generate one with: openssl rand -hex 32
WEBUI_SECRET_KEY=
